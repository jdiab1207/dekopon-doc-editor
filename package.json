{
  "name": "dekopon-doc-editor",
  "version": "1.0.0",
  "private": false,
  "description": "Open-source local document editor for AI agents — Google Docs–style UI with a local HTTP API and Cursor agent bridge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jdiab1207/dekopon-doc-editor.git"
  },
  "keywords": [
    "document-editor",
    "ai-agent",
    "mcp",
    "cursor",
    "tiptap",
    "local-first",
    "open-source"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "setup": "npm install && npx puppeteer browsers install chrome"
  },
  "dependencies": {
    "@tiptap/extension-color": "^2.11.5",
    "@tiptap/extension-font-family": "^2.11.5",
    "@tiptap/extension-highlight": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-subscript": "^2.11.5",
    "@tiptap/extension-superscript": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-text-align": "^2.11.5",
    "@tiptap/extension-text-style": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "chart.js": "^4.4.8",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "express": "^4.21.2",
    "html-to-docx": "^1.8.0",
    "html-to-image": "^1.11.13",
    "html-to-text": "^9.0.5",
    "jszip": "^3.10.1",
    "mammoth": "^1.9.0",
    "modern-screenshot": "^4.7.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.1.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^24.2.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.2.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.2.0"
  }
}
